+        # Sag taraf: sure + izlenen adres sayisi + hizli detach
+        stat_col = QVBoxLayout()
+        stat_col.setSpacing(1)
+        stat_col.setAlignment(Qt.AlignRight)
+        self.now_playing_uptime = QLabel("00:00:00")
+        self.now_playing_uptime.setObjectName("NowPlayingStatValue")
