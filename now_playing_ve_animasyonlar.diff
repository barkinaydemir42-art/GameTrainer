+class HoverElevation(QObject):
+    """GameCard'daki hover-golge efektinin genellenmis hali: herhangi bir
+    widget'a takilinca, fare uzerine gelince golgeyi yumusakca buyutup
+    ayrilinca soner - kart/buton "kaldirilabilir" hissi verir. Kisayol
+    kartlari, profil karti gibi GameCard olmayan widget'lar icin kullanilir
+    (GameCard kendi ozel implementasyonunu korur)."""
+
+    def __init__(self, widget, blur_max=22, color=QColor(124, 92, 255), parent=None):
+        super().__init__(parent or widget)
+        self.widget = widget
+        self.blur_max = blur_max
+        self.color = color
+
+        shadow = widget.graphicsEffect()
+        if not isinstance(shadow, QGraphicsDropShadowEffect):
+            shadow = QGraphicsDropShadowEffect(widget)
+            shadow.setOffset(0, 4)
+            shadow.setBlurRadius(0)
+            shadow.setColor(QColor(color.red(), color.green(), color.blue(), 0))
+            widget.setGraphicsEffect(shadow)
+        self._shadow = shadow
+        # Widget zaten sabit bir golgeyle geldiyse (_apply_shadow ile), hover
+        # bittiginde sifira degil bu taban degere donulur - kart "duz" hale
+        # gelip elevation'ini tamamen kaybetmesin diye.
+        self._base_blur = shadow.blurRadius()
+        self._base_color = shadow.color()
+
+        self._anim = QPropertyAnimation(self._shadow, b"blurRadius", self)
+        self._anim.setDuration(160)
+        self._anim.setEasingCurve(QEasingCurve.OutCubic)
+        widget.installEventFilter(self)
+
+    def eventFilter(self, obj, event):
+        if obj is self.widget:
+            if event.type() == QEvent.Enter:
+                self._shadow.setColor(QColor(self.color.red(), self.color.green(), self.color.blue(), 150))
+                self._animate_to(self.blur_max)
+            elif event.type() == QEvent.Leave:
+                self._shadow.setColor(self._base_color)
+                self._animate_to(self._base_blur)
+        return super().eventFilter(obj, event)
+
+    def _animate_to(self, value):
+        self._anim.stop()
+        self._anim.setStartValue(self._shadow.blurRadius())
+        self._anim.setEndValue(value)
+        self._anim.start()
+
