+        btn_detach_np.setObjectName("NowPlayingDetachBtn")
+        btn_detach_np.setCursor(Qt.PointingHandCursor)
+        btn_detach_np.clicked.connect(self._detach)
+        layout.addWidget(btn_detach_np)
+
+        self._now_playing_anim = None
+        return bar
+
+    def _set_now_playing_height(self, target: int):
+        """NowPlayingBar'in yuksekligini yumusakca hedefe animasyonla
+        getirir (0 = tamamen kapali, ~72 = acik)."""
+        if self._now_playing_anim is not None:
+            self._now_playing_anim.stop()
+        anim = QPropertyAnimation(self.now_playing_bar, b"maximumHeight", self.now_playing_bar)
+        anim.setDuration(240)
+        anim.setEasingCurve(QEasingCurve.OutCubic)
+        anim.setStartValue(self.now_playing_bar.maximumHeight())
+        anim.setEndValue(target)
+        anim.start()
+        self._now_playing_anim = anim
+
+    def _show_now_playing(self, process_name: str):
+        self._attach_time = datetime.now()
+        self.now_playing_title.setText(process_name)
+        dot_pix = get_pixmap("circle", color="#4CAF50", size=10)
+        if dot_pix is not None:
+            self.now_playing_dot.setPixmap(dot_pix)
+        else:
+            self.now_playing_dot.setText("\U0001F7E2")
+        self._update_now_playing_stats()
+        self._set_now_playing_height(72)
+
+        # Yesil nokta, baglanti rozetindeki gibi yavasca nabiz atar.
+        effect = QGraphicsOpacityEffect(self.now_playing_dot)
+        self.now_playing_dot.setGraphicsEffect(effect)
+        pulse = QPropertyAnimation(effect, b"opacity", self.now_playing_dot)
+        pulse.setDuration(1100)
+        pulse.setStartValue(1.0)
+        pulse.setKeyValueAt(0.5, 0.4)
+        pulse.setEndValue(1.0)
+        pulse.setLoopCount(-1)
+        pulse.setEasingCurve(QEasingCurve.InOutSine)
+        pulse.start()
+        self._now_playing_pulse = pulse
+
+    def _hide_now_playing(self):
+        self._attach_time = None
+        self._set_now_playing_height(0)
+        if getattr(self, "_now_playing_pulse", None) is not None:
+            self._now_playing_pulse.stop()
+            self.now_playing_dot.setGraphicsEffect(None)
+            self._now_playing_pulse = None
+
+    def _update_now_playing_stats(self):
+        """_tick() tarafindan (saniyede ~2 kez) cagrilir - sure ve
+        dondurulmus adres sayacini gunceller. Panel kapaliyken (baglanti
+        yokken) ucuz bir no-op olsun diye once kontrol edilir."""
+        if not hasattr(self, "now_playing_uptime"):
+            return
+        if self._attach_time is not None:
+            elapsed = int((datetime.now() - self._attach_time).total_seconds())
+            self.now_playing_uptime.setText(self._format_duration(elapsed))
+        frozen_count = len([w for w in getattr(self, "watched", []) if w.frozen])
+        self.now_playing_freeze.setText(str(frozen_count))
+
+    @staticmethod
+    def _format_duration(total_seconds: int) -> str:
+        h, rem = divmod(max(0, total_seconds), 3600)
+        m, s = divmod(rem, 60)
+        return f"{h:02d}:{m:02d}:{s:02d}"
+
