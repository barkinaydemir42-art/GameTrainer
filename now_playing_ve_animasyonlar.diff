+        self.status_watch_label.setText(f"Izlenen: {watched_count} (dondurulmus: {frozen_count})")
+
+        if self.engine.attached:
+            self.status_conn_label.setText(f"\u25CF Bagli: {self.engine.process_name}")
+            if self._attach_time is not None:
+                elapsed = int((datetime.now() - self._attach_time).total_seconds())
+                self.status_uptime_label.setText(f"Sure: {self._format_duration(elapsed)}")
+        else:
+            self.status_conn_label.setText("\u25CB Bagli degil")
+            self.status_uptime_label.setText("")
+
