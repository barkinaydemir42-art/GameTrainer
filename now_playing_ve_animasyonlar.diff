+        stat_col.addWidget(self.now_playing_uptime)
+        uptime_lbl = QLabel("SURE")
+        uptime_lbl.setObjectName("NowPlayingStatLabel")
+        uptime_lbl.setAlignment(Qt.AlignRight)
+        stat_col.addWidget(uptime_lbl)
+        layout.addLayout(stat_col)
+
+        stat_col2 = QVBoxLayout()
+        stat_col2.setSpacing(1)
+        stat_col2.setAlignment(Qt.AlignRight)
+        self.now_playing_freeze = QLabel("0")
+        self.now_playing_freeze.setObjectName("NowPlayingStatValue")
